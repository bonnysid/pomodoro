{
  "name": "pomodoro-desktop",
  "productName": "Pomodoro",
  "version": "0.2.5",
  "description": "A quiet, bilingual Pomodoro timer for Windows and macOS",
  "author": "Pomodoro",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "build/electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "start": "node scripts/start.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "node scripts/smoke.mjs",
    "test:persistence": "node scripts/persistence.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --arm64 --x64 --publish never",
    "format": "biome format --write .",
    "lint": "biome lint . --error-on-warnings",
    "check": "biome check . --error-on-warnings",
    "check:fix": "biome check --write .",
    "check:ci": "biome ci . --error-on-warnings",
    "verify": "npm run check && npm run typecheck && npm test",
    "test:new-day": "node scripts/new-day.mjs",
    "test:completion-window": "node scripts/completion-window.mjs",
    "test:release-notes": "node scripts/release-notes.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "44.3.0",
    "electron-builder": "^26.0.0",
    "playwright": "^1.56.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "app.pomodoro.desktop",
    "productName": "Pomodoro",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "build/**/*",
      "assets/icon.png",
      "assets/tray.png",
      "assets/trayTemplate.png",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity",
      "darkModeSupport": true
    },
    "artifactName": "Pomodoro-${version}-${os}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "bonnysid",
      "repo": "pomodoro",
      "releaseType": "release"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bonnysid/pomodoro.git"
  },
  "homepage": "https://github.com/bonnysid/pomodoro",
  "pomodoroMacUpdates": false
}
